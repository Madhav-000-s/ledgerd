# Claude Code local session data — never committed
.claude/
.claude

# Build output.
#
# The binary names are anchored to the repository root. A bare "ledgerd" would also match
# the cmd/ledgerd source directory, since a pattern with no slash matches at any depth —
# which silently excludes the program it was meant to protect against committing.
/bin/
/dist/
/ledgerd
/workerd
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & coverage artifacts
*.test
cover.out
coverage.html
/testdata/tmp/

# Go workspace files
go.work
go.work.sum

# Fuzzing corpus generated at runtime (seed corpus under testdata/fuzz IS committed)
**/testdata/fuzz/**/[0-9a-f]*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
